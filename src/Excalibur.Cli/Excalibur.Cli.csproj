<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Excalibur</AssemblyName>
    <RootNamespace>Excalibur.Cli</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Excalibur.Core\Excalibur.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\rules\ata-attributes.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>rules\ata-attributes.json</TargetPath>
    </None>
    <None Include="$(MSBuildThisFileDirectory)..\..\rules\vendor-overrides.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>rules\vendor-overrides.json</TargetPath>
    </None>
    <None Include="$(MSBuildThisFileDirectory)..\..\rules\verdict.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>rules\verdict.json</TargetPath>
    </None>
    <None Include="$(MSBuildThisFileDirectory)..\..\rules\rules-version.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>rules\rules-version.txt</TargetPath>
    </None>
  </ItemGroup>
</Project>
